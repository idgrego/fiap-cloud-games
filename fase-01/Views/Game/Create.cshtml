@model GameDto

@{
    ViewData["Title"] = "Cadastrar Jogo";
}

<div class="container mt-3">
    <h2>Cadastrar Novo Jogo</h2>
    <hr />

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <form asp-action="Create" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Ex: God of War, Minecraft..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Manufacturer" class="form-label"></label>
                    <input asp-for="Manufacturer" class="form-control" placeholder="Ex: Sony, EA, Nintendo..." />
                    <span asp-validation-for="Manufacturer" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Selecione uma Categoria --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Descrição resumida do jogo..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Online" />
                            <label class="form-check-label" asp-for="Online">Jogo Online</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Multiplayer" />
                            <label class="form-check-label" asp-for="Multiplayer">Suporta Multiplayer</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="UrlGame" class="form-label"></label>
                    <input asp-for="UrlGame" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="UrlGame" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UrlVideo" class="form-label"></label>
                    <input asp-for="UrlVideo" class="form-control" placeholder="https://youtube.com/..." />
                    <span asp-validation-for="UrlVideo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Photo" class="form-label"></label>
                    <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="Photo" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model GameDto

@{
    ViewData["Title"] = "Detalhes do Jogo";
}

<div class="container mt-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Jogos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">@Model.Name</h3>
            <span class="badge bg-light text-dark fs-6">@Model.CategoryName</span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <img src="@Url.Action("GetPhoto", "Game", new { id = Model.Id })" alt="@Model.Name"
                         class="img-fluid rounded shadow-sm" style="max-height: 300px; object-fit: contain;"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/300x300?text=Sem+Foto';" />
                </div>
                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-3">Fabricante</dt>
                        <dd class="col-sm-9">@Model.Manufacturer</dd>

                        <dt class="col-sm-3">Descrição</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "Nenhuma descrição informada." : Model.Description)</dd>

                        <dt class="col-sm-3">Recursos</dt>
                        <dd class="col-sm-9">
                            @if (Model.Online)
                            {
                                <span class="badge bg-success me-1">Online</span>
                            }
                            @if (Model.Multiplayer)
                            {
                                <span class="badge bg-info text-dark me-1">Multiplayer</span>
                            }
                            @if (!Model.Online && !Model.Multiplayer)
                            {
                                <span class="text-muted">Single-player Offline</span>
                            }
                        </dd>

                        @if (!string.IsNullOrWhiteSpace(Model.UrlGame))
                        {
                            <dt class="col-sm-3">Link do Jogo</dt>
                            <dd class="col-sm-9"><a href="@Model.UrlGame" target="_blank" rel="noopener noreferrer">Acessar
                                Jogo</a></dd>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.UrlVideo))
                            {
                                <dt class="col-sm-3">Vídeo / Trailer</dt>
                                <dd class="col-sm-9"><a href="@Model.UrlVideo" target="_blank"
                                                            rel="noopener noreferrer">Assistir Trailer</a></dd>
                                }

                                <dt class="col-sm-3">Cadastrado em</dt>
                                <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                    <div>
                        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning me-2">Editar</a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Excluir</a>
                    </div>
                </div>
            </div>
        </div>
@model UserDto

@{
    ViewData["Title"] = "Editar Usuário";
}

<div class="container mt-3">
    <h2>Editar Usuário</h2>
    <hr />

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <form asp-action="Update" enctype="multipart/form-data" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3 text-center">
                    <label class="form-label d-block">Foto de Perfil Atual</label>
                    <img src="@Url.Action("GetThumbnail", "User", new { id = Model.Id })" alt="@Model.FullName"
                         class="rounded-circle img-thumbnail mb-2"
                         style="width: 100px; height: 100px; object-fit: cover;"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/100?text=U';" />
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NickName" class="form-label"></label>
                    <input asp-for="NickName" class="form-control" />
                    <span asp-validation-for="NickName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" asp-for="Admin" />
                    <label class="form-check-label" asp-for="Admin">Usuário Administrador</label>
                </div>

                <div class="mb-3">
                    <label asp-for="ValidatedAt" class="form-label"></label>
                    <input asp-for="ValidatedAt" type="datetime-local" class="form-control" />
                    <span asp-validation-for="ValidatedAt" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Photo" class="form-label">Alterar Foto de Perfil (Opcional)</label>
                    <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="Photo" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
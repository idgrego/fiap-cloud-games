@model UserDto

@{
    ViewData["Title"] = "Excluir Usuário";
}

<div class="container mt-3">
    <div class="alert alert-danger text-center">
        <h4><i class="bi bi-exclamation-triangle-fill"></i> Confirmar Exclusão</h4>
        <p class="mb-0">Tem certeza de que deseja excluir o usuário abaixo? Esta ação não poderá ser desfeita.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body text-center">
            <img src="@Url.Action("GetThumbnail", "User", new { id = Model.Id })" alt="@Model.FullName"
                 class="rounded-circle img-thumbnail mb-3" style="width: 120px; height: 120px; object-fit: cover;"
                 onerror="this.onerror=null; this.src='https://via.placeholder.com/120?text=U';" />

            <h3>@Model.FullName</h3>
            <p class="text-muted mb-1">E-mail: <strong>@Model.Email</strong></p>
            @if (!string.IsNullOrWhiteSpace(Model.NickName))
            {
                <p class="text-muted">Nickname: <strong>@Model.NickName</strong></p>
            }

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
            </form>
        </div>
    </div>
</div>
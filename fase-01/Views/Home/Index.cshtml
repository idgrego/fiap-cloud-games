@{
    ViewData["Title"] = "Página Inicial";
}

<div class="px-4 py-5 my-5 text-center bg-light rounded-3 shadow-sm">
    <i class="bi bi-controller text-primary display-1 mb-3"></i>
    <h1 class="display-5 fw-bold">FIAP Cloud Games</h1>
    <div class="col-lg-6 mx-auto">
        <p class="lead mb-4">Plataforma de gerenciamento de jogos e usuários em nuvem. Navegue pelo catálogo de jogos ou
            gerencie os usuários cadastrados.</p>
            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                <a asp-controller="Game" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3"><i
                    class="bi bi-controller me-2"></i> Ver Jogos</a>
                    <a asp-controller="User" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4"><i
                        class="bi bi-people-fill me-2"></i> Ver Usuários</a>
                    </div>
                </div>
            </div>